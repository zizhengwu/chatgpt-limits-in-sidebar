{
  "manifest_version": 3,
  "name": "Simple ChatGPT Limits",
  "version": "1.2.2",
  "description": "See your remaining ChatGPT limits at a glance in the bottom-left sidebar, with no floating panel or setup needed.",
  "homepage_url": "https://github.com/zizhengwu/simple-chatgpt-limits",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Simple ChatGPT Limits",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-limits.user.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}

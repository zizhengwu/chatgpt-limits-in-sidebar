{
  "manifest_version": 3,
  "name": "Codex Usage in Sidebar",
  "version": "1.2.1",
  "description": "See remaining Codex usage and reset countdowns beside your ChatGPT profile.",
  "homepage_url": "https://github.com/zizhengwu/codex-limits-in-sidebar",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Codex Usage in Sidebar",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["codex-usage.user.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
